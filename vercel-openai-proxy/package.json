{
  "name": "collectivecare-openai-proxy",
  "private": true,
  "scripts": {
    "vercel-build": "npm run typecheck && node --import tsx scripts/apply-pilot-agreement.ts && node --import tsx scripts/preview-check.ts && node --import tsx scripts/apply-result-receipts.ts && node --import tsx scripts/production-check.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:condition-recovery": "node scripts/test-condition-recovery.mjs",
    "check:contracts": "node --import tsx scripts/generate-incremental-types.ts --check",
    "migrate:incremental": "node --import tsx scripts/apply-incremental.ts"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@vercel/queue": "^0.7.0",
    "jose": "^4.15.9",
    "openai": "^6.9.1",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/pg": "^8.23.1",
    "@vercel/node": "^16.0.1",
    "tsx": "^4.23.15",
    "typescript": "^5.4.0"
  }
}
