{
  "crons": [
    {
      "path": "/api/v1/health-processing/cleanup",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/v1/health-processing/record-recovery",
      "schedule": "15 4 * * *"
    }
  ],
  "functions": {
    "api/v1/health-processing/condition-workflow-queue.ts": {
      "maxDuration": 120,
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "condition-workflows",
          "maxDeliveries": 20
        }
      ]
    },
    "api/v1/health-processing/queue.ts": {
      "maxDuration": 300,
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "health-processing-jobs",
          "maxDeliveries": 20
        }
      ]
    },
    "api/v1/health-processing/continue.ts": {
      "maxDuration": 120
    },
    "api/v1/chat/completions.ts": {
      "maxDuration": 60
    },
    "api/v1/health-processing/stages.ts": {
      "maxDuration": 120
    },
    "api/v1/audio/transcriptions.ts": {
      "maxDuration": 120
    },
    "api/v1/health-processing/whole-history.ts": {
      "maxDuration": 300
    },
    "api/v1/health-processing/record-update-queue.ts": {
      "maxDuration": 60,
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "health-record-updates",
          "maxDeliveries": 20
        }
      ]
    },
    "api/v1/health-processing/record-recovery-queue.ts": {
      "maxDuration": 60,
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "health-record-recovery",
          "maxDeliveries": 20
        }
      ]
    }
  }
}
