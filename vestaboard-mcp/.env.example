# Vestaboard API mode:
# - cloud: uses https://cloud.vestaboard.com/
# - local: uses VESTABOARD_LOCAL_BASE_URL
VESTABOARD_API_MODE=cloud

# Required for cloud mode.
VESTABOARD_CLOUD_API_TOKEN=26d211df3c154403bfcbfdb88aa543b3

# Required for local mode.
VESTABOARD_LOCAL_BASE_URL=http://vestaboard.local:7000
VESTABOARD_LOCAL_API_KEY=26d211df3c154403bfcbfdb88aa543b3

# HTTP behavior.
VESTABOARD_REQUEST_TIMEOUT_MS=10000
VESTABOARD_RETRY_COUNT=2

# Logging: error, warn, info, or debug.
LOG_LEVEL=info
